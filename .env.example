# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=platform
POSTGRES_USER=platform
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# ─── AI providers ────────────────────────────────────────────────────────────
# Required: used for RAG embeddings (text-embedding-3-small)
OPENAI_API_KEY=sk-...

# Required for Anthropic models (default model is claude-sonnet-4-6)
ANTHROPIC_API_KEY=sk-ant-...

# ─── App secret ──────────────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
RAG_AGENT_SECRET_KEY=CHANGE_ME

# ─── Admin & access ──────────────────────────────────────────────────────────
# Comma-separated usernames that can access the admin panel
RAG_AGENT_ADMIN_USERNAMES=armann@orlanda.info

# Only emails from this domain can self-register
RAG_ALLOWED_EMAIL_DOMAIN=orlanda.info

# ─── Model ───────────────────────────────────────────────────────────────────
RAG_AGENT_MODEL=anthropic:claude-sonnet-4-6

# ─── CORS ────────────────────────────────────────────────────────────────────
RAG_CORS_ALLOWED_ORIGINS=https://platform.n8norlanda.com
