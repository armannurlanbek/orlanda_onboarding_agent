# ─────────────────────────────────────────────────────────────────────────────
# platform app — .env for the Orlanda failover cluster (see server-info/, DEPLOY_ORLANDA.md)
#
# Copy to `.env` on BOTH servers (Hetzner + OVH) into /opt/platform-agent/.
# The .env MUST be byte-for-byte identical on both servers — RAG_AGENT_SECRET_KEY
# in particular (it hashes passwords AND session tokens; a mismatch means nobody can
# log in after a failover). Same idea as n8n's N8N_ENCRYPTION_KEY.
#
# NOTE: the database URL is NOT set here. docker-compose.yml assembles it from
# DB_PASSWORD and points it at the db-router (127.0.0.1:6432 / db_platform).
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────────
# Password for the cluster Postgres user `platform`. Created once on the PRIMARY
# (see DEPLOY_ORLANDA.md step 2). Generate with: openssl rand -base64 18
DB_PASSWORD=CHANGE_ME

# ─── AI providers ────────────────────────────────────────────────────────────
# Required: RAG embeddings (text-embedding-3-small) always use OpenAI.
OPENAI_API_KEY=sk-...

# Required for the default Anthropic model (claude-sonnet-4-6).
ANTHROPIC_API_KEY=sk-ant-...

# ─── App secret (MUST MATCH ON BOTH SERVERS) ─────────────────────────────────
# Hashes passwords and bearer tokens. If the two servers differ, every login
# breaks the moment the app fails over. Generate ONCE, paste the same value on both:
#   python -c "import secrets; print(secrets.token_hex(32))"
RAG_AGENT_SECRET_KEY=CHANGE_ME

# ─── Admin & access ──────────────────────────────────────────────────────────
# Comma-separated usernames that can open the admin panel.
RAG_AGENT_ADMIN_USERNAMES=armann@orlanda.info

# Only emails from this domain (plus the admin short-names above) can self-register.
RAG_ALLOWED_EMAIL_DOMAIN=orlanda.info

# ─── Model ───────────────────────────────────────────────────────────────────
RAG_AGENT_MODEL=anthropic:claude-sonnet-4-6

# ─── CORS ────────────────────────────────────────────────────────────────────
# The public hostname served by the Cloudflare load balancer.
RAG_CORS_ALLOWED_ORIGINS=https://platform.n8norlanda.com

# ─── Monday OAuth (per-user integration) ─────────────────────────────────────
# Enable the integration + its OAuth login.
RAG_ENABLE_MONDAY_MCP=true
RAG_MONDAY_MCP_OAUTH_ENABLED=true

# From the Monday Developer Center OAuth app.
RAG_MONDAY_OAUTH_CLIENT_ID=CHANGE_ME
RAG_MONDAY_OAUTH_CLIENT_SECRET=CHANGE_ME

# Callback URL Monday redirects the browser back to after the user clicks Authorize.
# This MUST:
#   1) be your PUBLIC https URL (NOT a 192.168.x.x / LAN / localhost dev address —
#      the user's browser cannot reach a LAN IP, so login appears to "do nothing"), and
#   2) byte-for-byte match the redirect URL registered in the Monday Developer Center
#      OAuth app (also required at token exchange).
RAG_MONDAY_OAUTH_REDIRECT_URI=https://platform.n8norlanda.com/auth/monday/callback

# Space-separated scopes (must match the Monday app's granted permissions).
RAG_MONDAY_OAUTH_SCOPES=me:read boards:read boards:write

# Encrypts per-user OAuth tokens at rest. Required when Monday is enabled. Generate once
# and keep IDENTICAL on both servers: python -c "import secrets; print(secrets.token_hex(32))"
MONDAY_ENCRYPTION_KEY=CHANGE_ME

# Optional. Absolute base for the post-OAuth redirect back to the SPA. Leave EMPTY so the
# server issues a same-origin relative redirect ("/chat?monday_oauth=ok"), which is correct
# when the API and frontend share the public host. If set, it MUST be the public https
# origin (https://platform.n8norlanda.com) — NEVER a 192.168.x.x / LAN address.
RAG_FRONTEND_BASE_URL=
