# ─────────────────────────────────────────────────────────────────────────────
# platform app — .env for the Orlanda failover cluster (see server-info/, DEPLOY_ORLANDA.md)
#
# Copy to `.env` on BOTH servers (Hetzner + OVH) into /opt/platform-agent/.
# The .env MUST be byte-for-byte identical on both servers — RAG_AGENT_SECRET_KEY
# in particular (it hashes passwords AND session tokens; a mismatch means nobody can
# log in after a failover). Same idea as n8n's N8N_ENCRYPTION_KEY.
#
# NOTE: the database URL is NOT set here. docker-compose.yml assembles it from
# DB_PASSWORD and points it at the db-router (127.0.0.1:6432 / db_platform).
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────────
# Password for the cluster Postgres user `platform`. Created once on the PRIMARY
# (see DEPLOY_ORLANDA.md step 2). Generate with: openssl rand -base64 18
DB_PASSWORD=CHANGE_ME

# ─── AI providers ────────────────────────────────────────────────────────────
# Required: RAG embeddings (text-embedding-3-small) always use OpenAI.
OPENAI_API_KEY=sk-...

# Required for the default Anthropic model (claude-sonnet-4-6).
ANTHROPIC_API_KEY=sk-ant-...

# ─── App secret (MUST MATCH ON BOTH SERVERS) ─────────────────────────────────
# Hashes passwords and bearer tokens. If the two servers differ, every login
# breaks the moment the app fails over. Generate ONCE, paste the same value on both:
#   python -c "import secrets; print(secrets.token_hex(32))"
RAG_AGENT_SECRET_KEY=CHANGE_ME

# ─── Admin & access ──────────────────────────────────────────────────────────
# Comma-separated usernames that can open the admin panel.
RAG_AGENT_ADMIN_USERNAMES=armann@orlanda.info

# Only emails from this domain (plus the admin short-names above) can self-register.
RAG_ALLOWED_EMAIL_DOMAIN=orlanda.info

# ─── Model ───────────────────────────────────────────────────────────────────
RAG_AGENT_MODEL=anthropic:claude-sonnet-4-6

# ─── CORS ────────────────────────────────────────────────────────────────────
# The public hostname served by the Cloudflare load balancer.
RAG_CORS_ALLOWED_ORIGINS=https://platform.n8norlanda.com

# ─── monday.com integration (per-user OAuth + remote MCP) ────────────────────
# Optional. Enabled only when BOTH client id and secret are set. Each user connects
# their own monday account; the agent calls monday's remote MCP with that user's token,
# so monday enforces the user's own permissions. Register one monday App in the Developer
# Center, set its OAuth scopes to match RAG_MONDAY_OAUTH_SCOPES below, and set its redirect
# URL to:  https://platform.n8norlanda.com/auth/monday/callback
RAG_MONDAY_OAUTH_CLIENT_ID=
RAG_MONDAY_OAUTH_CLIENT_SECRET=
# Space-separated scopes — MUST match the scopes configured on the monday App.
RAG_MONDAY_OAUTH_SCOPES=me:read boards:read boards:write workspaces:read users:read teams:read account:read updates:read updates:write docs:read
# Optional. Leave empty in prod to derive the redirect URI from RAG_FRONTEND_BASE_URL
# (which must be the public https origin). Set explicitly only for non-standard setups.
RAG_MONDAY_OAUTH_REDIRECT_URI=
# Optional. Remote MCP endpoint. Leave RAG_MONDAY_API_VERSION EMPTY so the MCP server uses its
# own current API version — pinning an old one breaks tool queries ("Cannot query field ...").
RAG_MONDAY_MCP_URL=https://mcp.monday.com/mcp
RAG_MONDAY_API_VERSION=
# Optional. Explicit Fernet key (urlsafe base64, 32 bytes) for encrypting stored monday
# tokens at rest. If empty, a key is derived from RAG_AGENT_SECRET_KEY. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RAG_MONDAY_TOKEN_ENC_KEY=
